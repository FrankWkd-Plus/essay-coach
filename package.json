{
  "name": "essay-coach",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Serverless AI English essay coach for Chinese junior-high students",
  "scripts": {
    "dev": "wrangler dev",
    "dev:local": "wrangler dev -c wrangler.local.toml",
    "deploy": "wrangler deploy",
    "test": "node --test tests/*.test.js",
    "db:local": "wrangler d1 execute essay-coach-db --local -c wrangler.local.toml --file=./schema.sql",
    "db:remote": "wrangler d1 execute essay-coach-db --remote --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.164.0"
  },
  "engines": {
    "node": ">=20"
  }
}
